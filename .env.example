# =============================================================================
# Esses Analytics — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env` (see .gitignore).
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# ---- Core (REQUIRED) --------------------------------------------------------
# Local Postgres created by this project's setup; swap for a managed Postgres
# (Neon/Supabase) at deploy time — connection string only, no code changes.
DATABASE_URL=postgres://esses_app:CHANGE_ME@localhost:5432/esses_analytics

# Secret for signing session cookies. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_min_32_chars

# Shared secret guarding POST /api/sync, so the nightly scheduled refresh can run
# without a user session. Generate the same way: openssl rand -base64 48
#
# Only needed on a DEPLOYED instance. Leave it blank locally — the sync route then
# refuses every request, which is the intended fail-closed behaviour, not a fault.
# On Vercel, set it and the cron sends it automatically.
CRON_SECRET=

# ---- Seed (used only by `pnpm db:seed`) -------------------------------------
# Initial password for the seeded admin accounts (Sam, Johnny). Change after
# first login. If unset, the seed script generates a random one and prints it.
SEED_ADMIN_PASSWORD=

# ---- Shopify Admin API (Phase 2) --------------------------------------------
# MUST be the store's myshopifyDomain (from `shop { myshopifyDomain }`), NOT the
# primary domain — the OAuth token endpoint rejects the primary domain.
SHOPIFY_SHOP=9fee88-ec.myshopify.com
SHOPIFY_API_VERSION=2025-07
# Preferred: Dev Dashboard app credentials. The app exchanges these for a 24-hour
# token automatically (client-credentials grant) and refreshes as needed.
# Dev Dashboard → your app → Settings → Client ID / Client secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional override for a legacy custom-app static token (skips the exchange).
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ---- Skio (Phase 3) ---------------------------------------------------------
SKIO_API_KEY=

# ---- Stripe — print + digital subscriptions (Phase 2) -----------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Split print vs digital. Comma-separated Stripe price IDs (or product IDs).
# Whatever isn't listed falls back to name heuristics, then STRIPE_DEFAULT_LINE.
STRIPE_PRINT_PRICE_IDS=
STRIPE_DIGITAL_PRICE_IDS=
STRIPE_DEFAULT_LINE=print

# ---- Meta Marketing API (Phase 5) -------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---- Mailgun — sends the daily digest email (Phase 9/14), later the newsletter (Phase 11) --
# Sign up at mailgun.com, verify a sending domain (or subdomain, e.g. mail.essesmag.com — a
# subdomain avoids touching essesmag.com's existing DNS/deliverability), then paste the
# Private API key from Settings → API Keys and the verified domain below.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: defaults to reports@<MAILGUN_DOMAIN>.
MAILGUN_FROM=
# Optional: only set this if the Mailgun account is EU-region — https://api.eu.mailgun.net.
# Wrong region gives an opaque 401, not a helpful error, so check Settings → API Keys if the
# digest fails to send.
MAILGUN_API_BASE=
# Comma-separated recipients for the daily digest (CPR, churn, new subs, ad spend breakdown
# for the previous day — see /api/cron/daily-digest). No spaces needed around the commas.
DIGEST_RECIPIENTS=sam@essesmag.com,johnny@essesmag.com,ojus@essesmag.com,hugh@essesmag.com

# ---- Slack — failure alerts (Phase 9 / 14) -----------------------------------
SLACK_BOT_TOKEN=
SLACK_DIGEST_CHANNEL=
SLACK_ALERT_CHANNEL=

# ---- Claude API — the /ask analyst ------------------------------------------
# Wired up 11 Aug 2026. Optional: without a key /ask shows a "not configured"
# notice and nothing else in the app is affected.
#
# Model confirmed at build time, per the note this replaces. Opus 5 because the
# work is reasoning-shaped rather than throughput-shaped — a cohort question takes
# several tool calls plus a judgement about which margin boundary applies.
# claude-sonnet-5 is the sensible cheaper swap if cost becomes the constraint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Google Analytics 4 (content metrics only) ---
# Setup walkthrough: docs/ga4-setup.md
# The NUMERIC Property ID (9-10 digits), not the G-... Measurement ID.
GA4_PROPERTY_ID=
# Absolute path to the service-account JSON key. Keep the file OUTSIDE this folder.
GA4_CREDENTIALS_PATH=
