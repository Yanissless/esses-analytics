# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# The dev server's own build dir, so a `build` can't break a running `dev`.
# See next.config.ts and the `dev` branch in run.cmd.
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; the example template IS committed
.env
.env.*
!.env.example

# local database volume / dumps
/pgdata
*.dump
*.sql.bak

# weekly handoff packages (EXPORT-FOR-HUGH.cmd) — contain a real customer DB dump
/handoff-exports/

# local visual preview of the daily digest (scripts/send-daily-digest.ts) — real business numbers
/digest-preview.html
/digest-preview-*.html

# drizzle: keep migrations, ignore transient meta journal only if desired (we keep it)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
